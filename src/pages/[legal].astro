---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
import { COMPLIANCE } from '../data/bio.js';

/**
 * The footer links five legal pages. ASSET-REQUEST.md §6 records that none of
 * them have counsel-approved content yet, and recommends a lawyer draft them
 * given the site references stem cell and regenerative therapies.
 *
 * Shipping a dead link is worse than shipping an honest holding page, and
 * shipping invented legal text is worse than both. So: the Disclaimer carries
 * the compliance statement that *has* been drafted, the other four say plainly
 * that they are in review, and all five are noindex so thin pages never enter
 * the index or dilute the home page.
 */
export function getStaticPaths() {
  return [
    { params: { legal: 'privacy' }, props: { title: 'Privacy Policy' } },
    { params: { legal: 'cookie-policy' }, props: { title: 'Cookie Policy' } },
    { params: { legal: 'disclaimer' }, props: { title: 'Disclaimer', full: true } },
    { params: { legal: 'terms' }, props: { title: 'Terms & Conditions' } },
    { params: { legal: 'acceptable-use' }, props: { title: 'Acceptable Use' } },
  ];
}

const { title, full = false } = Astro.props;
---

<Base title={`${title} — ${SITE.name}`} noindex>
  <section class="legal">
    <div class="legal__wrap">
      <p class="eyebrow">Legal</p>
      <h1 class="legal__h1">{title}</h1>

      {
        full ? (
          <div class="legal__prose">
            {COMPLIANCE.map((c) => (
              <p>
                <strong>{c.lead}</strong> {c.body}
              </p>
            ))}
          </div>
        ) : (
          <div class="legal__prose">
            <p>
              This policy is being finalised with counsel before launch. In the meantime, questions
              about how this site handles your information can go directly to{' '}
              <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>.
            </p>
            <p>
              The medical compliance statement that governs everything published here is available
              on the <a href="/disclaimer">Disclaimer</a> page.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .legal {
    padding: 136px var(--gutter) var(--section-y);
  }
  .legal__wrap {
    max-width: 720px;
    margin-inline: auto;
  }
  .legal__h1 {
    margin: 0 0 36px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .legal__prose p {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-muted);
  }
  .legal__prose strong {
    color: var(--ink);
    font-weight: 500;
  }
</style>
