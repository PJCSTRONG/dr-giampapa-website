---
import { Image } from 'astro:assets';
import { KEYNOTES } from '../data/speaking.js';
import { asset } from '../lib/assets.js';
---

<section class="section keynotes" id="keynotes" aria-labelledby="keynotes-h">
  <div class="wrap">
    <p class="eyebrow">Keynote</p>
    <h2 class="display keynotes__h" id="keynotes-h" data-reveal="0">See him work.</h2>

    <ul class="videos">
      {
        KEYNOTES.map((v, i) => {
          // Served locally rather than from i.ytimg.com: the poster is the LCP
          // candidate in this section, and a third-party image request would
          // add a DNS lookup and TLS handshake before it can even start.
          const poster = asset(`keynotes/${v.id}.jpg`);
          return (
          <li data-reveal={i}>
            <div class="frame">
              {/* Facade: a static poster and 0 bytes of YouTube JS until click.
                  The iframe is injected on demand by the layout script. */}
              <button
                class="facade"
                type="button"
                data-video={v.id}
                data-video-title={`${v.title} — ${v.venue}`}
              >
                {poster && (
                  <Image
                    src={poster}
                    alt=""
                    widths={[640, 960, 1280]}
                    sizes="(max-width: 900px) 92vw, 560px"
                    loading="lazy"
                    format="webp"
                  />
                )}
                <span class="facade__play" aria-hidden="true" />
                <span class="visually-hidden">Watch the keynote — {v.title}</span>
              </button>
            </div>
            <div class="caption">
              <p class="caption__title">
                {v.title} <span>&mdash; {v.venue}</span>
              </p>
              <p class="caption__cue">Watch the keynote</p>
            </div>
          </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .keynotes {
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .keynotes__h {
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: clamp(28px, 3.4vw, 48px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--ink);
  }
  .frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--ink);
    cursor: pointer;
  }
  /* :global — <Image> is a component, so its <img> does not receive this
     component's scope attribute. */
  .facade :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 250ms ease;
  }
  .facade:hover :global(img) {
    opacity: 1;
  }

  .facade__play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgb(251 250 247 / 0.9);
    transition: background 200ms ease;
  }
  .facade__play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -40% -50%;
    border-left: 15px solid var(--ink);
    border-block: 9px solid transparent;
    transition: border-left-color 200ms ease;
  }
  .facade:hover .facade__play {
    background: var(--accent);
  }
  .facade:hover .facade__play::after {
    border-left-color: #fff;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 16px;
  }
  .caption__title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
  }
  .caption__title span {
    color: var(--ink-muted);
    font-weight: 400;
  }
  .caption__cue {
    margin: 0;
    font-size: 14px;
    color: var(--ink-muted);
  }
</style>
