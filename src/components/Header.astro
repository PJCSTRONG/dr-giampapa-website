---
import { SITE, HERO } from '../data/site.js';
---

<header class="hdr" data-header>
  <a class="hdr__mark" href="/">Vincent Giampapa, MD</a>

  <div class="hdr__right">
    <nav class="hdr__nav" aria-label="Primary">
      {SITE.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="btn btn--primary hdr__cta" href="#about">{HERO.cta}</a>

    <button
      class="hdr__burger"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="visually-hidden">Menu</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<nav class="menu" id="mobile-menu" data-menu hidden aria-label="Mobile">
  {SITE.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  <a class="btn btn--primary menu__cta" href="#about">{HERO.cta}</a>
</nav>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    height: 72px;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: clamp(20px, 4.5vw, 64px);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    transition:
      background 300ms ease,
      backdrop-filter 300ms ease;
  }

  .hdr.is-stuck {
    background: rgb(251 250 247 / 0.94);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
  }

  .hdr__mark {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hdr__right {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 36px);
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 30px);
  }
  .hdr__nav a {
    font-size: 15px;
    color: var(--ink);
  }
  .hdr__nav a:hover {
    color: var(--accent);
  }

  .hdr__cta {
    height: 44px;
    padding-inline: 22px;
    font-size: 15px;
  }

  .hdr__burger {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .hdr__burger span[aria-hidden] {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
  }

  .menu {
    position: fixed;
    inset: 72px 0 auto;
    z-index: 55;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px clamp(20px, 4.5vw, 64px) 32px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .menu[hidden] {
    display: none;
  }
  .menu a {
    font-size: 18px;
    color: var(--ink);
  }
  .menu__cta {
    align-self: flex-start;
    margin-top: 6px;
    color: #fff;
  }

  /* The design file switched at 940px via a resize listener. A media query does
     the same job with no JS and no layout shift on first paint. */
  @media (max-width: 940px) {
    .hdr__nav {
      display: none;
    }
    .hdr__burger {
      display: flex;
    }
  }

  @media (max-width: 560px) {
    .hdr__cta {
      display: none;
    }
  }
</style>
