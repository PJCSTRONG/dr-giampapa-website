---
import { SPEAKING_ENQUIRY } from '../data/site.js';
import { TOPICS, STAGES } from '../data/speaking.js';
---

<section class="speaking" id="speaking" aria-labelledby="speaking-h">
  <div class="panel speaking__panel">
    <div class="speaking__inner">
      <p class="speaking__eyebrow">Speaking</p>
      <h2 class="speaking__h" id="speaking-h" data-reveal="0">Bring him to your stage.</h2>

      <p class="speaking__body" data-speakable>
        He has made this case at the Vatican, at Beijing University, and in Stockholm. Cellular
        aging. Epigenetic reprogramming. The science redefining how long a human being can stay
        well.
      </p>

      <ul class="topics">
        {TOPICS.map((t) => <li>{t}</li>)}
      </ul>

      <a class="btn btn--onDark speaking__cta" href={SPEAKING_ENQUIRY}>Check availability &rarr;</a>

      <ul class="stages" aria-label="Previous stages">
        {STAGES.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .speaking {
    padding-block: clamp(40px, 5vw, 72px);
  }

  .speaking__panel {
    padding: clamp(64px, 9vw, 140px) clamp(24px, 5vw, 96px);
  }

  .speaking__inner {
    max-width: 1000px;
    margin-inline: auto;
  }

  .speaking__eyebrow {
    margin: 0 0 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  .speaking__h {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .speaking__body {
    margin: 28px 0 clamp(48px, 5.5vw, 72px);
    max-width: 60ch;
    font-size: 18px;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.8);
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 0 clamp(32px, 4vw, 64px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topics li {
    padding: 22px 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: 16px;
    color: #fff;
  }
  .topics li:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }

  .speaking__cta {
    margin-top: clamp(44px, 5vw, 64px);
  }

  .stages {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: clamp(44px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }
  .stages li:not(:last-child)::after {
    content: ' ·';
    margin-left: 18px;
  }
</style>
